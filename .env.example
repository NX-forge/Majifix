# PostgreSQL connection string. Use a dedicated database for MajiFix.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/majifix?schema=public"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: seed demo records. Never use demo credentials in production.
SEED_DEMO_PASSWORD="ChangeThisDemoPassword123!"
