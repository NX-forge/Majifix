# Copy to .env.production on the deployment host. Replace every value.
# Never commit .env.production or place these values in NEXT_PUBLIC_* variables.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/majifix?sslmode=require"
# Use the direct (non-pooler) Neon host for Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-NEON-DIRECT-HOST/majifix?sslmode=require"
BETTER_AUTH_SECRET="GENERATE_A_UNIQUE_SECRET_WITH_OPENSSL_RAND_BASE64_48"
BETTER_AUTH_URL="https://your-real-domain.example"
NEXT_PUBLIC_APP_URL="https://your-real-domain.example"
RESEND_API_KEY="re_REPLACE_WITH_LIVE_RESEND_KEY"
RESEND_FROM_EMAIL="MajiFix <no-reply@your-verified-domain.example>"
NOTIFICATION_WORKER_SECRET="GENERATE_A_DIFFERENT_UNIQUE_SECRET_WITH_OPENSSL_RAND_BASE64_48"
BETTER_AUTH_TRUSTED_ORIGINS=""
